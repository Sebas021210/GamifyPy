# Copia este archivo como backend/.env (en esta misma carpeta) y llena los valores.

# Cadena de conexión de PostgreSQL (Neon / Supabase / local)
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Clave para firmar los tokens JWT (genera una larga y aleatoria)
SECRET_KEY=cambia_esto_por_una_clave_larga

# URL del frontend (sin "/" al final). Se usa para el login con Google y el correo de recuperación.
FRONTEND_URL=http://localhost:5173

# Dominios que pueden llamar a la API, separados por coma. "*" = cualquiera.
CORS_ORIGINS=*

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=

# Gmail (el servidor y puerto ya están fijos en el código: smtp.gmail.com:587)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
